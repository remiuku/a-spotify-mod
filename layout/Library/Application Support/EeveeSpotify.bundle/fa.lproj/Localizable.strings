// Lyrics

do_not_replace_lyrics = "جایگزین نکردن متن آهنگ";
lyrics_source = "منبع متن آهنگ";
lyrics_source_description = "می‌توانید منبع متن آهنگ مورد نظر خود را انتخاب کنید.

Genius: بهترین کیفیت متن آهنگ را ارائه می‌دهد، بیشترین تعداد آهنگ را پوشش می‌دهد و سریع‌ترین به‌روزرسانی‌ها را دارد. از متن همگام با زمان پشتیبانی نمی‌کند و هرگز نخواهد کرد.

LRCLIB: آزادترین سرویس متن آهنگ که متن‌های همگام با زمان را ارائه می‌دهد. با این حال، برای بسیاری از آهنگ‌ها متن در دسترس ندارد.

Musixmatch: سرویسی که Spotify از آن استفاده می‌کند. برای بسیاری از آهنگ‌ها متن همگام با زمان ارائه می‌دهد، اما برای استفاده از آن به توکن کاربری نیاز دارید.";
lyrics_additional_info = "اگر EeveeSpotify نتواند آهنگی را پیدا کند یا متن آن را پردازش کند، پیام «متن این آهنگ بارگیری نشد» را مشاهده خواهید کرد. هنگام استفاده از Genius ممکن است متن برخی آهنگ‌ها به دلیل نحوه جستجوی آهنگ‌ها توسط توییک نادرست باشد، اما این مشکل در بیشتر موارد برطرف شده است.";
spicylyrics_description = "SpicyLyrics متن آهنگ‌های کارائوکه را کلمه‌به‌کلمه ارائه می‌دهد. به‌طور پیش‌فرض از یک کلید داخلی استفاده می‌شود. اگر می‌خواهید از کلید خودتان استفاده کنید، به قالب Spicy ESR بروید و دکمه «Sign in» را بزنید. پس از ورود، شرایط خدمات (ToS) اسپایسی را بپذیرید و «Add ESR to my account» را بزنید. پس از افزوده شدن، کلید ساخته‌شده را کپی کنید، در بخش متن آهنگ Eevee جای‌گذاری کنید، سپس به Spicy برگردید و روی «I have stored it» کلیک کنید. بعد به صفحه برنامه‌ها بروید.";
